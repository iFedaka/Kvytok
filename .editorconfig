[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = warning

# EF Core writes these; regenerated ones would break the style rules again so no point in fixing already generated code
[**/Migrations/*.cs]
generated_code = true

# Extension methods live in the namespace they extend, so callers need no using
[src/Kvytok.ServiceDefaults/Extensions.cs]
dotnet_diagnostic.IDE0130.severity = none